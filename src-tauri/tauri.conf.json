{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LogStudio",
  "version": "1.0.0",
  "identifier": "dev.logstudio.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LogStudio",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "dragDropEnabled": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "yhwanp",
    "copyright": "Copyright (c) 2026 yhwanp",
    "license": "MIT",
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
